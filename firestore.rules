rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // This is an intentionally unauthenticated, private-group shared board.
    match /campaigns/{campaignId}/players/{playerId} {
      allow read, write: if true;
    }
    match /campaigns/{campaignId}/mapState/{mapDocId} {
      allow read, write: if true;
    }
  }
}

